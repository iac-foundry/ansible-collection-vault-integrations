[Unit]
Description=Vault Agent - Automatic secret delivery and renewal
Documentation=https://www.vaultproject.io/docs/
Requires=network-online.target
After=network-online.target
ConditionFileNotEmpty={{ vault_agent_config_dir }}/agent.hcl

[Service]
Type=notify
EnvironmentFile=-/etc/sysconfig/vault
EnvironmentFile=-/etc/default/vault
ExecStart={{ vault_agent_binary_path }} agent -config={{ vault_agent_config_dir }}/agent.hcl
ExecReload=/bin/kill -HUP $MAINPID

User=vault-agent
Group=vault-agent

# Create /run/vault-agent (the parent of vault_agent_socket_path) before
# ExecStart, owned by the service user. Without it the agent's unix
# listener failed with "bind: no such file or directory" -- /run is tmpfs
# and the directory existed nowhere. RuntimeDirectory is the idiomatic
# fix: systemd creates it on start (recreated each boot), unlike a one-off
# mkdir in the role that would not survive a reboot.
RuntimeDirectory={{ vault_agent_socket_path | dirname | basename }}
RuntimeDirectoryMode=0750

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vault-agent

# Security settings
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
SecureBits=keep-caps
AmbientCapabilities=CAP_IPC_LOCK
CapabilityBoundingSet=CAP_SYSLOG CAP_IPC_LOCK
LimitNOFILE=65536

KillMode=process
KillSignal=SIGINT
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
